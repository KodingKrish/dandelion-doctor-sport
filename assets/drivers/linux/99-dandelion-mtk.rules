# dandelion-doctor — udev rules for Redmi 9A Sport (M2006C3LI / dandelion)
# Prevents ModemManager from claiming the MTK BROM/Preloader/DA VCOM ports,
# which otherwise blocks enumeration (Section 9.1, FIX-00019 family).

# BROM
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="0003", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# Preloader VCOM
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="2000", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# DA VCOM
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="2001", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# META mode
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="2007", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
# Xiaomi Fastboot / ADB / Sideload
SUBSYSTEM=="usb", ATTR{idVendor}=="2717", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0666", ENV{ID_MM_DEVICE_IGNORE}="1"
